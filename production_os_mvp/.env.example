# Copy to .env.local and fill locally. Never commit .env.local.
FREELLMAPI_URL=http://127.0.0.1:3001
FREELLMAPI_API_KEY=
# Comma-separated exact model IDs confirmed free in your FreeLLMAPI account.
FREELLMAPI_FREE_VIDEO_MODELS=
# Set to 1 only if the active FreeLLMAPI video fallback chain contains free-only models.
FREELLMAPI_VIDEO_AUTO_FREE_CONFIRMED=0

AGNES_BASE_URL=https://apihub.agnes-ai.com
AGNES_API_KEY=
# Leave empty unless the selected Agnes video model is explicitly confirmed free.
AGNES_FREE_VIDEO_MODELS=
AGNES_VIDEO_FREE_CONFIRMED=0
